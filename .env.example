# ---------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------

# Signs the session cookie that holds payment state.
# Generate with:  openssl rand -hex 32
# Changing this logs every active session out.
SESSION_SECRET=replace_with_a_64_character_hex_string_from_openssl_rand_hex_32

# Razorpay -> Settings -> API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
# The secret is used only on the server and is never sent to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Price in paise. 4900 = Rs 49.
PRICE_PAISE=4900

# Optional: point at a dataset outside the repo.
# DATASET_PATH=/var/data/dataset.json

# Public site URL, used for canonical tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
