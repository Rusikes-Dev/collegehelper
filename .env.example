# CollegeHelper.xyz — copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---------------------------------------------------------------
# Project Settings > API. The anon key is safe in the browser; RLS constrains it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS entirely. Must never be prefixed NEXT_PUBLIC_ and
# must never be imported into a client component. Used by API routes and by
# the cutoff import script.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by scripts/import-cutoffs.ts, run from your machine.
SUPABASE_URL=https://your-project.supabase.co

# --- Razorpay ---------------------------------------------------------------
# Key ID is sent to the browser to open Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Secret signs and verifies payments. Server-only, no exceptions.
RAZORPAY_KEY_SECRET=
# Set in the Razorpay dashboard under Webhooks; verifies webhook authenticity.
RAZORPAY_WEBHOOK_SECRET=

# --- Application ------------------------------------------------------------
# Canonical origin, used for OG tags, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://collegehelper.xyz

# Secret used to sign the short-lived access token issued after payment or
# restore. Generate with: openssl rand -base64 32
ACCESS_TOKEN_SECRET=

# --- Notes ------------------------------------------------------------------
# The predictor price and its FREE/PAID mode are NOT environment variables.
# They live in the site_settings table and are changed from /admin at runtime.
