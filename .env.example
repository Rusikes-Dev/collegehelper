# ---------------------------------------------------------------
# Copy to .env.local for local work, and paste the same values into
# Vercel -> Settings -> Environment Variables for the deployment.
# Never commit .env.local.
# ---------------------------------------------------------------

# === Required ===================================================

# Signs the session cookie that holds payment state.
# Generate with:  openssl rand -hex 32
# Changing this logs every active session out.
SESSION_SECRET=replace_with_a_64_character_hex_string_from_openssl_rand_hex_32

# Razorpay -> Settings -> API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
# The secret is used only on the server and is never sent to the browser.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL, used for canonical tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://your-domain.com


# === Supabase ===================================================
# Stores students, payments, access grants and visitor analytics.
#
# Without these the site still runs and still takes payments, but access
# lives only in the browser cookie: students cannot restore it on another
# device, and the admin panel has nothing to show.
#
# Supabase -> Project Settings -> Data API for the URL,
# Supabase -> Project Settings -> API Keys for the service-role key.
# Run supabase/schema.sql in the SQL editor before first use.

SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# SERVER ONLY. This key bypasses row-level security and can read every
# student's email and phone number. Never prefix it with NEXT_PUBLIC_,
# never paste it into client code, never commit it.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# === Admin panel ================================================
# The panel lives at /admin. It is disabled until a password is set.

# At least 10 characters. Use a password manager to generate one.
# Changing this immediately signs out any open admin session.
ADMIN_PASSWORD=

# Shown in the audit log next to actions you take. Cosmetic.
ADMIN_EMAIL=you@your-domain.com

# Optional. Signs the admin cookie separately from student sessions, so
# rotating one does not disturb the other. Falls back to SESSION_SECRET.
# ADMIN_SESSION_SECRET=another_64_character_hex_string


# === Payments ===================================================

# Price in paise. 4900 = Rs 49.
PRICE_PAISE=4900

# How long access lasts after payment, in days. 365 is a full admission
# cycle. Set to 0 for access that never expires.
ACCESS_VALIDITY_DAYS=365

# Strongly recommended once live.
#
# Students pay on phones, and UPI apps routinely switch away from the
# browser without coming back. When that happens the money is taken but
# the browser never confirms it, and without this webhook the student is
# left paid-but-locked-out. With it, access is granted server-side and
# they simply restore with their email and mobile number.
#
# Razorpay -> Settings -> Webhooks -> Add New Webhook
#   URL:    https://your-domain.com/api/payment/webhook
#   Events: payment.captured, payment.failed
#   Secret: whatever you put below (this is NOT your API key secret)
RAZORPAY_WEBHOOK_SECRET=


# === Optional ===================================================

# Point at a dataset outside the repo.
# DATASET_PATH=/var/data/dataset.json
